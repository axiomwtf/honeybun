diff --git i/.gn w/.gn
index 5f9df22..75115c6 100644
--- i/.gn
+++ w/.gn
@@ -30,7 +30,7 @@ default_args = {
   symbol_level = 1
   use_debug_fission = false
 
-  v8_embedder_string = "-rusty"
+  v8_embedder_string = "-honeybun"
 
   v8_enable_javascript_promise_hooks = true
   v8_promise_internal_field_count = 1
@@ -94,4 +94,55 @@ default_args = {
 
   # Disable C++ modules - they're not compatible with bindgen
   use_clang_modules = false
+
+  ###########################################################################
+  # HONEYBUN OPTIMIZATION PATCHES
+  #
+  # Only real V8 15.8 GN args here (verified against upstream gni/v8.gni and
+  # BUILD.gn at 15.8.62.23). Items that are V8 runtime v8_flags, not build
+  # args, are applied at engine creation in honeybun src/runtime.rs instead:
+  #   Maglev tier threshold  -> --invocation-count-for-maglev=100  (patch 6)
+  #   TurboFan tier threshold-> --invocation-count-for-turbofan=750 (patch 7)
+  #   Initial heap 32MB      -> --initial-heap-size=32             (patch 10)
+  #   Stack trace depth 10   -> --stack-trace-limit=10             (patch 12;
+  #                             already the V8 default, kept explicit)
+  #   Lazy source positions  -> already the V8 default             (patch 11)
+  #   GC logging off         -> already the V8 default             (patch 5)
+  #   Source-map support     -> embedder-driven, no build toggle   (patch 13)
+  #
+  # NOTE: v8_enable_pointer_compression changes the V8 ABI; when building the
+  # fork you must either pass the same value here as rusty_v8's build.rs
+  # writes to args.gn (default: false unless the
+  # `v8_enable_pointer_compression` cargo feature is on) or build with the
+  # feature enabled. GN silently ignores default_args entries no arg consumes,
+  # so a wrong name here degrades to "not applied", never to a build failure.
+  ###########################################################################
+
+  # 1. Disable WebAssembly (arg renamed v8_enable_wasm -> v8_enable_webassembly
+  #    in modern V8). Node-style workloads do not need it; drops the wasm
+  #    compiler/builtins and shrinks the binary.
+  v8_enable_webassembly = false
+
+  # 2. Disable Intl (real arg name: v8_enable_i18n_support; drops the ICU data
+  #    dependency and Intl builtins).
+  v8_enable_i18n_support = false
+
+  # 3. Disable debug features (real arg name: v8_enable_debugging_features).
+  v8_enable_debugging_features = false
+
+  # 8. Optimize V8's own C++ for speed in otherwise-optimized-off builds
+  #    (real arg, kept so debug/dev builds of the fork stay fast).
+  v8_optimized_debug = true
+
+  # 9. Enable huge pages for the code range (real arg, -DENABLE_HUGEPAGE).
+  v8_enable_hugepage = true
+
+  # 14. Enable pointer compression (memory savings; see ABI note above).
+  v8_enable_pointer_compression = true
+
+  # 15. Strip inspector. No dedicated GN arg exists in V8 15.8 for the core
+  #     inspector's inclusion; set to false is a no-op unless upstream defines
+  #     the arg. The real strip happens in the medium patch (patched binding
+  #     sources drop src/inspector_protocol from the build graph).
+  v8_enable_inspector = false
 }
